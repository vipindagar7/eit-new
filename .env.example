# Copy to .env.local for local development.
# NEXT_PUBLIC_* values are exposed to the browser. NEVER put secrets in them.

NEXT_PUBLIC_SITE_URL=https://eitfaridabad.com
NEXT_PUBLIC_SITE_NAME=Echelon Institute of Technology

# Keep "false" while every route is a Coming Soon placeholder.
# Set to "true" only when the real site goes live.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" shows clearly labelled SAMPLE entries in homepage sections whose real content is still empty,
# so the layout can be reviewed. Keep "false" in production: empty sections then hide themselves.
NEXT_PUBLIC_SAMPLE_CONTENT=false
